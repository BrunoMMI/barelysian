---
import { Image } from "astro:assets";
import logoSource from "../assets/logo-source.png";

interface Props {
  width: number;
  class?: string;
  loading?: "eager" | "lazy";
  alt?: string;
  variant?: "dark" | "light";
}

const {
  width,
  class: className,
  loading = "lazy",
  alt = "Elysian – Sorsi di Poesia",
  variant = "dark",
} = Astro.props;
const height = Math.round((width * logoSource.height) / logoSource.width);
const classes = [className, variant === "light" ? "logo--light" : undefined]
  .filter(Boolean)
  .join(" ");
---
<Image
  src={logoSource}
  alt={alt}
  width={width}
  height={height}
  densities={[1, 2]}
  class={classes || undefined}
  loading={loading}
/>

<style>
  .logo--light {
    filter: brightness(0) invert(1);
  }
</style>
