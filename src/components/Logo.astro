---
import { Image } from "astro:assets";
import logoSource from "../assets/logo-source.png";

interface Props {
  width: number;
  class?: string;
  loading?: "eager" | "lazy";
  alt?: string;
}

const {
  width,
  class: className,
  loading = "lazy",
  alt = "Elysian – Sorsi di Poesia",
} = Astro.props;
const height = Math.round((width * logoSource.height) / logoSource.width);
---
<Image
  src={logoSource}
  alt={alt}
  width={width}
  height={height}
  densities={[1, 2]}
  class={className}
  loading={loading}
/>
