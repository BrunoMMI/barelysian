---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__logo">
    <Logo width={56} alt="" variant="light" />
  </div>
  <p class="site-footer__payoff">Sorsi di Poesia</p>
  <p class="site-footer__note">Menù sempre in continuo aggiornamento</p>
  <p class="site-footer__copy">&copy; {year} Elysian</p>
</footer>

<style>
  .site-footer {
    text-align: center;
    padding: 3rem 1.25rem 2.5rem;
    background: var(--color-teal);
    color: var(--color-cream);
    border-top: 1px solid var(--color-gold-soft);
  }

  .site-footer__logo {
    display: inline-block;
  }

  .site-footer__payoff {
    font-family: var(--font-display);
    color: var(--color-gold-on-teal);
    margin: 0.75rem 0 0.5rem;
  }

  .site-footer__note {
    font-size: 0.8rem;
    opacity: 0.75;
    margin: 0 0 0.75rem;
  }

  .site-footer__copy {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0;
  }
</style>
